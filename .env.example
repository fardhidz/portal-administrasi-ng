# Salin file ini jadi .env (untuk dev lokal) ATAU set langsung di
# Vercel Dashboard > Project > Settings > Environment Variables.

# Wajib untuk fitur sync (/api/sync, /api/data) berfungsi:
# 1. Buat project di supabase.com (gratis), lalu ambil dari
#    Project Settings > API:
SUPABASE_URL=
# Pakai "service_role" key (BUKAN "anon" key) -> ini yang punya akses
# tulis ke tabel portal_cache dari server. JANGAN pernah taruh key ini
# di kode yang jalan di browser (src/**), hanya boleh di api/**.
SUPABASE_SERVICE_ROLE_KEY=

# 2. Jalankan supabase/migration.sql sekali di Supabase SQL Editor
#    untuk membuat tabel portal_cache.

# 3. Secret untuk melindungi /api/sync dari dipanggil sembarang orang.
#    Vercel Cron OTOMATIS mengirim ini sebagai header Authorization saat
#    menjalankan jadwal harian di vercel.json. Untuk tombol "Sinkronkan
#    Sekarang" di dashboard, masukkan nilai yang sama saat diminta.
#    Gunakan string acak minimal 16 karakter.
CRON_SECRET=

# Opsional: override URL Google Sheet sumber data tanpa perlu ubah kode.
# Kalau kosong, pakai URL default yang sudah ada di api/sync.js.
GOOGLE_SHEET_URL=
